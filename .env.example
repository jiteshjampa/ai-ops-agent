# Free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: Slack -> Apps -> Incoming Webhooks -> create one for a test channel.
# If left unset, Slack calls are simulated and logged instead of sent.
SLACK_WEBHOOK_URL=

# Optional: real task backends. Checked in this order: Jira, then Notion,
# then falls back to a local JSON file if neither is set. See
# agent/jira_client.py and agent/notion_client.py for full setup steps.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

NOTION_API_KEY=
NOTION_DATABASE_ID=

# Optional: Gmail sending. Requires a credentials.json file in the project
# root (not an env var) -- see agent/gmail_client.py for full setup steps.
